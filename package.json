{
  "name": "selecttrans",
  "version": "2.2.0",
  "private": true,
  "description": "划词译 · SelectTrans —— Chrome MV3 划词翻译扩展",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node build.mjs",
    "test": "node build.mjs && node test-providers.js && node test-smoke.js",
    "test:e2e": "testkit run tests/e2e/selection-bubble.spec.mjs tests/e2e/pages.spec.mjs --extension=dist",
    "zip": "node build.mjs --zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
